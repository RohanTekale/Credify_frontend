```gitignore
# ─── Node ─────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Build ────────────────────────────
dist/
build/
.vite/

# ─── Environment ──────────────────────
.env
.env.*
!.env.example

# ─── OS / Editor ──────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Logs ─────────────────────────────
logs/
*.log

# ─── Docker (optional) ────────────────
docker-compose.override.yml

# ─── Misc ─────────────────────────────
*.zip
*.tar
*.gz

# Ignore temp folders
untitled folder/
```
untitled folder.zip
